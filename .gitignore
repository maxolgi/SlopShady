# Rust build artifacts
slopshady/target/
**/target/

# WebView2 runtime data
*.exe.WebView2/

# Self-signed TLS certs (auto-generated into --data-dir on first run)
cert.pem
key.pem

# App state (per AGENTS.md: shaders.json lives in --data-dir, gitignored)
shaders.json

# Logs and scratch
logs/
tmp/

# Local-only files (machine-specific configs, personal state, scratch notes)
slopshady.local.conf
playlist.json
plan.md

# opencode session state
.opencode/

# TypeScript toolchain
node_modules/

# Frontend + engine build output (regenerated from src/js/ and
# vendor/QuicSRT-wasm/ by build.rs: tsc emit, js mirror, emcc engine stage)
static/js/
static/vendor/
