{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "noEmit": false,
        "rootDir": "src/js",
        "outDir": "static/js",
        "paths": {
            "/wasm/*": ["static/wasm/*"],
            "/static/vendor/WebSRT/web/src/*": ["static/vendor/WebSRT/web/src/*"]
        }
    },
    "include": ["src/js/**/*.ts"]
}
